{
  "name": "shopware-playwright-suite",
  "version": "1.0.0",
  "private": true,
  "description": "Reusable Playwright + TypeScript E2E test skeleton for Shopware 6.7 storefronts",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --project=firefox --grep @smoke",
    "test:regression": "playwright test --grep-invert @mobile",
    "test:mobile": "playwright test --project=mobile",
    "test:client": "playwright test tests/client",
    "test:headed": "playwright test --headed --project=chromium",
    "test:ui": "playwright test --ui",
    "test:list": "playwright test --list",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "install:browsers": "playwright install --with-deps chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.10.0",
    "dotenv": "^17.2.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20"
  }
}
